// Prisma schema for Stavba - Budget & Time Tracking
// for Construction / Reconstruction Projects
//
// NOTE on PostgreSQL/Supabase migration:
// To switch to PostgreSQL, change the datasource provider below to "postgresql"
// and set DATABASE_URL to the Supabase Postgres connection string, then run:
//   bun run db:push
// All field types here are PostgreSQL-compatible (no SQLite-only features).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ===== PROJECTS =====
model Project {
  id            String   @id @default(cuid())
  name          String
  address       String?
  description   String?
  starred       Boolean  @default(false)
  status        String   @default("active") // active, planning, completed, paused
  currency      String   @default("CZK")
  totalBudget   Float    @default(0) // optional overall budget cap
  startDate     DateTime?
  endDate       DateTime?
  // JSON array of category names in display order (for reordering categories)
  categoryOrder String?
  // Free-form markdown notes for the project (decisions, ideas, todos)
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  budgetItems BudgetItem[]
  contacts    Contact[]
  auditLogs   AuditLog[]
  snapshots   Snapshot[]
}

// ===== SNAPSHOTS =====
// Saves a point-in-time copy of project totals for "plan vs reality" comparison.
model Snapshot {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  label       String   // e.g., "Konec přípravy", "Po demolici"
  planTotal   Float
  actualTotal Float
  remaining   Float
  burnRate    Float
  hoursTotal  Float
  daysPlanned Float
  itemCount   Int
  completedCount Int
  savedTotal  Float
  createdAt   DateTime @default(now())
}

// ===== AUDIT LOG =====
// Records changes to budget items, payments, time entries, contacts, and projects.
// Each entry captures: entity type, entity ID, action (create/update/delete),
// field changed, old value, new value, and timestamp.
model AuditLog {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  entityType String  // "BudgetItem", "Payment", "TimeEntry", "Contact", "Project"
  entityId   String
  action    String   // "create", "update", "delete"
  field     String?  // which field changed (null for create/delete)
  oldValue  String?
  newValue  String?
  createdAt DateTime @default(now())
}

// ===== BUDGET ITEMS =====
// Core entity: each row in the budget (category/subcategory/element)
model BudgetItem {
  id                String   @id @default(cuid())
  projectId         String
  project           Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  category          String   // e.g., "Hrubá stavba"
  subcategory       String?  // e.g., "Hydroizolace - projekt"
  element           String?  // "Prvek / Úkol" - description of the task/element
  phase             String   // Příprava, Demolice, Hrubá stavba, Zabydlování, Do budoucna, Neurčeno
  required          Boolean  @default(false) // "Nutné" - is it mandatory?
  completed         Boolean  @default(false) // is this item finished?
  note              String?
  unitPrice         String?  // e.g., "1200,- / m"
  // Plan
  planCost          Float?   // Plán (Kč)
  flexibilityPercent Float?  // Vůle (%) - how flexible the estimate is
  planDays          Float?   // Plán (dní)
  dateFrom          DateTime? // Datum od
  dateTo            DateTime? // Datum do
  // Actual
  actualCost        Float    @default(0) // Skutečnost (Kč) - aggregated from payments
  actualHours       Float    @default(0) // Skutečnost (hod) - aggregated from time entries
  // Ordering
  sortOrder         Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  payments   Payment[]
  timeEntries TimeEntry[]
}

// ===== CONTACTS (Workers / Companies / Suppliers) =====
model Contact {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name      String
  type      String   // company, craftsman, self, supplier, architect, office
  role      String?  // e.g., "Zedník", "Elektrikář", "Architekt"
  phone     String?
  email     String?
  company   String?
  notes     String?
  rating    Int?     // 1-5 stars
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  timeEntries TimeEntry[]
  payments    Payment[]
}

// ===== PAYMENTS =====
// Records actual financial transactions linked to budget items.
// Supports installments: a "parent" payment represents an invoice with
// `invoiceTotal` (expected total) and `amount = 0`. Child payments with
// `installmentOf = parent.id` record each partial payment.
// Standalone full payments have `installmentOf = null` and `invoiceTotal = null`.
model Payment {
  id            String   @id @default(cuid())
  budgetItemId  String
  budgetItem    BudgetItem @relation(fields: [budgetItemId], references: [id], onDelete: Cascade)
  contactId     String?
  contact       Contact?   @relation(fields: [contactId], references: [id], onDelete: SetNull)
  amount        Float    // paid amount for this record (0 for a pure invoice parent)
  invoiceTotal  Float?   // the full invoice amount expected (set on parent/installment group)
  installmentOf String?  // parent payment id if this is an installment (plain string, no FK)
  vatRate       Float?   // VAT rate in percent (e.g., 21 for 21%)
  vatAmount     Float?   // computed VAT amount (amount * vatRate / (100 + vatRate))
  date          DateTime
  type          String   // receipt, work, material, person, invoice, other
  vendor        String?  // obchod / firma
  invoiceNumber String?
  description   String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// ===== TIME ENTRIES =====
// Records actual time worked on tasks. Supports multi-day entries via `dateTo`.
// If dateTo is set, the entry spans date..dateTo and `hours` is the total
// hours across the whole range.
model TimeEntry {
  id           String   @id @default(cuid())
  budgetItemId String
  budgetItem   BudgetItem @relation(fields: [budgetItemId], references: [id], onDelete: Cascade)
  contactId    String?
  contact      Contact?   @relation(fields: [contactId], references: [id], onDelete: SetNull)
  workerName   String   // free-text worker name (for quick entry)
  workerType   String   // company, craftsman, self, family
  date         DateTime
  dateTo       DateTime? // optional end date for multi-day entries
  hours        Float    // total hours across the range
  description  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
