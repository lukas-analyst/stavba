// Prisma schema for RekonstrukcePro - Budget & Time Tracking
// for Reconstruction Projects

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ===== PROJECTS =====
model Project {
  id          String   @id @default(cuid())
  name        String
  address     String?
  description String?
  starred     Boolean  @default(false)
  status      String   @default("active") // active, planning, completed, paused
  currency    String   @default("CZK")
  totalBudget Float    @default(0) // optional overall budget cap
  startDate   DateTime?
  endDate     DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  budgetItems BudgetItem[]
  contacts    Contact[]
}

// ===== BUDGET ITEMS =====
// Core entity: each row in the budget (category/subcategory/element)
model BudgetItem {
  id                String   @id @default(cuid())
  projectId         String
  project           Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  category          String   // e.g., "Hrubá stavba"
  subcategory       String?  // e.g., "Hydroizolace - projekt"
  element           String?  // "Prvek / Úkol" - description of the task/element
  phase             String   // Příprava, Demolice, Hrubá stavba, Zabydlování, Do budoucna, Neurčeno
  required          Boolean  @default(false) // "Nutné" - is it mandatory?
  note              String?
  unitPrice         String?  // e.g., "1200,- / m"
  // Plan
  planCost          Float?   // Plán (Kč)
  flexibilityPercent Float?  // Vůle (%) - how flexible the estimate is
  planDays          Float?   // Plán (dní)
  dateFrom          DateTime? // Datum od
  dateTo            DateTime? // Datum do
  // Actual
  actualCost        Float    @default(0) // Skutečnost (Kč) - aggregated from payments
  actualHours       Float    @default(0) // Skutečnost (hod) - aggregated from time entries
  // Ordering
  sortOrder         Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  payments   Payment[]
  timeEntries TimeEntry[]
}

// ===== CONTACTS (Workers / Companies / Suppliers) =====
model Contact {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name      String
  type      String   // company, craftsman, self, supplier, architect, office
  role      String?  // e.g., "Zedník", "Elektrikář", "Architekt"
  phone     String?
  email     String?
  company   String?
  notes     String?
  rating    Int?     // 1-5 stars
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  timeEntries TimeEntry[]
  payments    Payment[]
}

// ===== PAYMENTS =====
// Records actual financial transactions linked to budget items
model Payment {
  id            String   @id @default(cuid())
  budgetItemId  String
  budgetItem    BudgetItem @relation(fields: [budgetItemId], references: [id], onDelete: Cascade)
  contactId     String?
  contact       Contact?   @relation(fields: [contactId], references: [id], onDelete: SetNull)
  amount        Float
  date          DateTime
  type          String   // receipt, work, material, person, invoice, other
  vendor        String?  // obchod / firma
  invoiceNumber String?
  description   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// ===== TIME ENTRIES =====
// Records actual time worked on tasks, linked to budget items and contacts
model TimeEntry {
  id           String   @id @default(cuid())
  budgetItemId String
  budgetItem   BudgetItem @relation(fields: [budgetItemId], references: [id], onDelete: Cascade)
  contactId    String?
  contact      Contact?   @relation(fields: [contactId], references: [id], onDelete: SetNull)
  workerName   String   // free-text worker name (for quick entry)
  workerType   String   // company, craftsman, self, family
  date         DateTime
  hours        Float
  description  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
