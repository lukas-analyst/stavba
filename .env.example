# Copy this file to .env and set your DATABASE_URL
# Neon PostgreSQL connection string (get from https://neon.tech dashboard)
#
# Use Neon's "-pooler" hostname for connection pooling (PgBouncer).
# The pgbouncer=true param tells Prisma to use PgBouncer-compatible mode
# (no prepared statements, which PgBouncer transaction mode doesn't support).
# connection_limit=1 is recommended for serverless (Vercel) to avoid
# connection exhaustion — each function instance uses only one connection.
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/database?sslmode=require&pgbouncer=true&connection_limit=1&connect_timeout=15&pool_timeout=10

# Optional: read replica URL (Neon Pro tier).
# When set, read-heavy routes (dashboard, budget list, payments list, etc.)
# use this connection instead of the primary, reducing load on the primary.
# If not set, the primary DATABASE_URL is used for both reads and writes.
# READ_DATABASE_URL=postgresql://user:password@ep-xxx-replica-pooler.region.aws.neon.tech/database?sslmode=require&pgbouncer=true&connection_limit=5

# Optional: connection pool tuning (defaults shown)
# DATABASE_CONNECTION_LIMIT=5
# DATABASE_POOL_TIMEOUT=30
